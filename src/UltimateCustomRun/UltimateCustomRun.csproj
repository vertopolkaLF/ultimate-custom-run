<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UltimateCustomRun</AssemblyName>
    <RootNamespace>UltimateCustomRun</RootNamespace>
    <Version>1.7.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Sts2Path Condition="'$(Sts2Path)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
    <GameDataPath>$(Sts2Path)/data_sts2_windows_x86_64</GameDataPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameDataPath)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDataPath)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDataPath)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDataPath)/sts2.dll')" Text="Game assembly not found. Pass -p:Sts2Path=PATH_TO_GAME." />
  </Target>
</Project>
